<Project>
  <!-- Caller assets are opt-in; required package notices use standard build/publish copying. -->
  <Target Name="CollectDotnet2DAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Include="$(MSBuildThisFileDirectory)../LICENSE" Link="licenses/Dotnet2D.Engine/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(EngineAsset)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
