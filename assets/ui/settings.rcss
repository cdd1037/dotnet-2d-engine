/* Settings profile v1; finite grammar documented in managed/UiAuthoring.cs.
   Density-independent dp dimensions. Noto Sans CJK SC is loaded by the adapter.
   Rounded button backgrounds only; rectangular list clipping, no transforms. */
body {
    font-family: "Noto Sans CJK SC";
    font-size: 16dp;
    font-weight: normal;
    color: #edf3fc;
    width: 100%;
    height: 100%;
}
#settings-panel {
    position: absolute;
    left: 24dp;
    top: 16dp;
    width: 470dp;
    padding: 18dp;
    background-color: #172338;
    border-width: 1dp;
    border-color: #4c6486;
}
div {
    display: block;
}
h1 {
    display: block;
    font-size: 24dp;
    margin: 0dp 0dp 6dp;
}
h2 {
    display: block;
    font-size: 16dp;
    margin: 10dp 0dp 8dp;
}
p {
    display: block;
    margin: 0dp;
    line-height: 140%;
}
.hint {
    color: #b7c8de;
    font-size: 14dp;
}
label {
    display: block;
    margin-top: 10dp;
    margin-bottom: 4dp;
}
input {
    display: block;
    width: 450dp;
    height: 28dp;
    padding: 4dp 8dp;
    color: #edf3fc;
    background-color: #0e192b;
    border-width: 1dp;
    border-color: #6582a6;
    font-size: 16dp;
}
input:focus {
    border-color: #83c7ff;
}
#volume {
    height: 24dp;
    padding: 0dp;
    border-width: 0dp;
    background-color: transparent;
}
#volume slidertrack {
    height: 8dp;
    margin-top: 8dp;
    background-color: #405778;
}
#volume sliderbar {
    width: 18dp;
    height: 24dp;
    margin-top: 0dp;
    background-color: #83c7ff;
}
#volume sliderprogress {
    background-color: #568fc8;
}
#volume sliderarrowdec {
    display: none;
}
#volume sliderarrowinc {
    display: none;
}
.actions {
    margin-top: 10dp;
    margin-bottom: 8dp;
}
button {
    display: inline-block;
    padding: 6dp 18dp;
    margin-right: 10dp;
    background-color: #345c87;
    color: #ffffff;
    border-width: 1dp;
    border-color: #7098c5;
    border-radius: 6dp;
}
button:hover {
    background-color: #4476a9;
}
button:focus {
    border-color: #d9edff;
}
button:active {
    background-color: #214465;
}
#status {
    font-size: 14dp;
    color: #b9e6c9;
}
#item-list {
    height: 104dp;
    padding: 4dp;
    overflow-x: hidden;
    overflow-y: auto;
    background-color: #0e192b;
    border-width: 1dp;
    border-color: #405778;
}
.list-item {
    padding: 6dp 8dp;
    font-size: 14dp;
    line-height: 140%;
    word-break: break-all;
}
#item-list scrollbarvertical {
    width: 12dp;
}
#item-list scrollbarvertical slidertrack {
    background-color: #243951;
}
#item-list scrollbarvertical sliderbar {
    width: 10dp;
    min-height: 16dp;
    background-color: #6a91bd;
}
#item-list scrollbarvertical sliderarrowdec {
    display: none;
}
#item-list scrollbarvertical sliderarrowinc {
    display: none;
}
