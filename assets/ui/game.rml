<?xml version="1.0" encoding="utf-8"?>
<rml>
  <head><title>Courier Mission / 运送任务</title><link type="text/rcss" href="game.rcss" /></head>
  <body>
    <div id="hud">
      <p id="hud-objective">Deliver the cell / 运送能量电池</p>
      <p id="hud-status">WASD move · E interact · F drop · T door</p>
      <p id="hud-time">Time / 剩余: 90 s</p>
      <button id="game-pause">Pause / 暂停</button>
    </div>
    <div id="game-panel">
      <h1 id="game-title">Courier Mission / 运送任务</h1>
      <p id="game-objective">Carry the energy cell through the east door and deliver it to the archive.</p>
      <p id="game-status">Ready / 准备就绪</p>
      <p id="game-time">Time / 剩余: 90 s</p>
      <div id="game-actions">
        <button id="game-start">Start / 开始</button>
        <button id="game-resume">Resume / 继续</button>
        <button id="game-save">Save / 保存</button>
        <button id="game-load">Load / 读取</button>
        <button id="game-restart">Restart / 重试</button>
        <button id="game-menu">Menu / 主菜单</button>
      </div>
    </div>
  </body>
</rml>
