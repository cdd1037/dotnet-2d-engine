body { font-family: "Noto Sans CJK SC"; font-size: 16dp; color: #edf3fc; width: 100%; height: 100%; }
h1 { position: absolute; left: 64dp; top: 16dp; font-size: 24dp; margin: 0dp; }
p { display: block; margin: 0dp; }
#status { position: absolute; left: 64dp; top: 428dp; font-size: 16dp; }
.controls { position: absolute; left: 64dp; top: 460dp; font-size: 16dp; }
.hint { position: absolute; left: 64dp; top: 490dp; font-size: 14dp; color: #b7c8de; }
