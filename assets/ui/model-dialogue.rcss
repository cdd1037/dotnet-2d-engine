body { font-family: "Noto Sans CJK SC"; font-size: 15dp; color: #eee9f5; width: 100%; height: 100%; background-color: #171622; }
div, h1, h2, p { display: block; }
.panel { position: absolute; left: 44dp; top: 26dp; width: 824dp; padding: 24dp; background-color: #242232; border: 1dp #59516d; border-radius: 12dp; }
.eyebrow { color: #c5acf0; font-size: 12dp; letter-spacing: 2dp; margin-bottom: 5dp; }
h1 { font-size: 28dp; margin: 0dp 0dp 21dp; }
h2 { font-size: 18dp; margin: 0dp; }
p { margin: 0dp; line-height: 150%; }
.conversation { display: flex; padding: 19dp; background-color: #302c41; border-radius: 8dp; }
.speaker { width: 165dp; margin-right: 22dp; }
.portrait { width: 48dp; height: 48dp; margin-bottom: 9dp; text-align: center; line-height: 48dp; font-size: 27dp; background-color: #74628e; border: 1dp #c5acf0; border-radius: 24dp; }
.role { margin-top: 4dp; font-size: 12dp; color: #bfb3cf; }
.message { flex: 1; padding-top: 5dp; }
#dialogue-message { font-size: 18dp; line-height: 150%; }
.aside { margin-top: 15dp; color: #bfb3cf; font-size: 13dp; }
.choice-heading { margin: 19dp 0dp 8dp; font-size: 12dp; letter-spacing: 2dp; color: #c5acf0; }
.choices { height: 133dp; overflow-y: auto; overflow-x: hidden; }
button { display: inline-block; color: #eee9f5; padding: 6dp 15dp; background-color: #504360; border: 1dp #8b759f; border-radius: 5dp; font-size: 13dp; }
button:hover { background-color: #655377; }
button:focus { border-color: #ecdbff; }
button:active { background-color: #3d344b; }
button.choice { display: block; width: 788dp; margin: 0dp 0dp 7dp; text-align: left; padding: 8dp 12dp; background-color: #302c41; border-color: #59516d; font-size: 14dp; }
button.choice:hover { background-color: #443953; border-color: #c5acf0; }
button.choice:disabled { color: #81788f; border-color: #3e384a; background-color: #272431; }
.choice-marker { display: inline-block; width: 22dp; color: #d4b6ff; }
.choice-note { margin-left: 16dp; font-size: 12dp; color: #bfb3cf; }
.footer { display: flex; align-items: center; justify-content: space-between; margin-top: 14dp; padding-top: 12dp; border-top: 1dp #59516d; }
#dialogue-status { color: #bfb3cf; font-size: 12dp; }
scrollbarvertical { width: 10dp; }
scrollbarvertical slidertrack { background-color: #171622; }
scrollbarvertical sliderbar { width: 8dp; min-height: 18dp; background-color: #8b759f; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { display: none; }
