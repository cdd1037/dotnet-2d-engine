body { font-family: "Noto Sans CJK SC"; font-size: 14dp; color: #f2eee5; width: 100%; height: 100%; background-color: #201d18; }
div, h1, h2, p { display: block; }
.panel { position: absolute; left: 28dp; top: 22dp; width: 858dp; padding: 22dp; background-color: #2c2922; border: 1dp #625a49; border-radius: 12dp; }
.eyebrow { color: #e5c68a; font-size: 12dp; letter-spacing: 2dp; margin-bottom: 5dp; }
h1 { font-size: 28dp; margin: 0dp 0dp 19dp; }
h2 { font-size: 18dp; margin: 0dp 0dp 7dp; }
p { margin: 0dp; line-height: 145%; }
.settings-layout { display: flex; height: 323dp; }
.profile { width: 278dp; padding: 16dp; margin-right: 16dp; background-color: #353127; border-radius: 8dp; }
label { display: block; margin: 15dp 0dp 5dp; color: #cfc4ad; font-size: 13dp; }
input { display: block; color: #f2eee5; background-color: #201d18; border: 1dp #88785a; font-size: 15dp; }
#player-name { width: 260dp; height: 27dp; padding: 4dp 8dp; }
input:focus { border-color: #f4dcae; }
#volume-value { color: #f4dcae; margin-left: 10dp; }
#volume { width: 278dp; height: 24dp; border-width: 0dp; background-color: transparent; }
#volume slidertrack { height: 6dp; margin-top: 9dp; background-color: #635941; }
#volume sliderbar { width: 16dp; height: 24dp; background-color: #e5c68a; border-radius: 4dp; }
#volume sliderprogress { background-color: #b39050; }
#volume sliderarrowdec, #volume sliderarrowinc { display: none; }
.hint-row { display: flex; align-items: center; margin-top: 14dp; }
.hint-row label { margin: 0dp 0dp 0dp 10dp; }
#hints, .toggle { display: inline-block; width: 20dp; height: 20dp; border-radius: 4dp; }
#hints:checked, .toggle:checked { background-color: #e5c68a; border-color: #f4dcae; }
.profile-note { margin-top: 22dp; color: #ad9f85; font-size: 12dp; }
.groups { flex: 1; overflow-y: auto; overflow-x: hidden; }
.group { padding: 13dp 15dp; margin-bottom: 10dp; background-color: #353127; border-radius: 8dp; }
.group-description { color: #ad9f85; font-size: 12dp; margin-bottom: 9dp; }
.option { display: flex; align-items: center; justify-content: space-between; padding: 8dp 0dp; border-top: 1dp #514938; }
.option-copy { flex: 1; }
.option-weight { display: block; color: #ad9f85; font-size: 11dp; margin-top: 2dp; }
.footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16dp; padding-top: 12dp; border-top: 1dp #625a49; }
#settings-status { color: #cfc4ad; font-size: 12dp; }
button { display: inline-block; padding: 6dp 16dp; color: #292319; background-color: #e5c68a; border: 1dp #f4dcae; border-radius: 5dp; font-size: 13dp; }
button:hover { background-color: #f4dcae; }
button:focus { border-color: #ffffff; }
button:active { background-color: #bfa064; }
scrollbarvertical { width: 10dp; }
scrollbarvertical slidertrack { background-color: #201d18; }
scrollbarvertical sliderbar { width: 8dp; min-height: 18dp; background-color: #88785a; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { display: none; }
