<?xml version="1.0" encoding="utf-8"?>
<rml>
  <head>
    <title>Team roster / 队伍</title>
    <link type="text/rcss" href="roster.rcss" />
  </head>
  <body data-model="model">
    <div id="roster-panel" class="panel">
      <h1 id="caption">{{state.title}}</h1>
      <p class="hint">A second document using the same model API / 同一个绑定接口</p>
      <div class="actions"><button id="add" data-event-click="add()">Add member / 添加成员</button></div>
      <div id="members"><button class="bound-row" data-for="item : state.items"
        data-event-click="select(item.id)" data-attrif-disabled="!item.enabled"
        data-class-selected="item.selected">{{item.text}}</button></div>
    </div>
  </body>
</rml>
