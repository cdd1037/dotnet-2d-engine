<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep strict per-document null resolver/DTD rejection; avoid unused default network resolver roots. -->
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <AssemblyName>GameAuthoringLab</AssemblyName>
    <RootNamespace>GameAuthoringLab</RootNamespace>
  </PropertyGroup>
  <Import Project="../engine/RuntimeSources.props" />
  <ItemGroup>
    <Compile Remove="@(EngineRuntimeSource)" />
    <ProjectReference Include="../engine/Dotnet2D.Engine.csproj" />
    <!-- Exercise the exact game-authored public consumer in focused/source tests too. -->
    <Compile Include="../packaging/consumers/composition/Composition.cs;../packaging/consumers/composition/CompositionChecks.cs" Link="CompositionSample/%(Filename)%(Extension)" />
    <Content Include="../assets/materials/*.material.json" Link="assets/materials/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/materials/tint.frag.spv;../assets/materials/desaturate.frag.spv" Link="assets/materials/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/materials/*.spv" Exclude="../assets/materials/tint.frag.spv;../assets/materials/desaturate.frag.spv" Link="assets/materials/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/*.tilemap.json" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/*.physics.json" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/audio/*.wav;../assets/audio/*.ogg" Link="assets/audio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/*.mission.json" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/*.scene.json" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/*.bmp" Exclude="../assets/room-a.bmp;../assets/room-b.bmp" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/room-a.bmp;../assets/room-b.bmp" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="../assets/ui/*" Link="assets/ui/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareRoomAssets" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)/../assets/room-a.bmp') Or !Exists('$(MSBuildProjectDirectory)/../assets/room-b.bmp')">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../scripts/prepare-room-assets.sh&quot;" />
  </Target>
  <Target Name="PrepareMaterialAssets" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)/../assets/materials/tint.frag.spv') Or !Exists('$(MSBuildProjectDirectory)/../assets/materials/desaturate.frag.spv')">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../scripts/compile-materials.py&quot;" />
  </Target>
</Project>
